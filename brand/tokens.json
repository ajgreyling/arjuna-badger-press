{
  "$meta": {
    "brand": "Arjuna Badger Press",
    "version": "3.0.0",
    "note": "The archer-and-badger palette (badger colours retained; the archer adds the loosed-arrow motif). See brand/BRAND.md + brand/BRAND_BRIEF_ARJUNA_BADGER.md for usage rules. CSS variables use the --abp-* prefix."
  },
  "color": {
    "core": {
      "badgerBlack": { "hex": "#161513", "rgb": [22, 21, 19],   "role": "Primary dark surface (warm near-black / the body / the ink)" },
      "ironEarth":   { "hex": "#3A332B", "rgb": [58, 51, 43],   "role": "Raised dark surface / cards" },
      "boneStripe":  { "hex": "#EDE9E0", "rgb": [237, 233, 224], "role": "Primary light text on dark / the signature underline (not pure white)" },
      "veldOchre":   { "hex": "#B07A3C", "rgb": [176, 122, 60], "role": "Primary accent — honey/earth / CTAs / links / the spark" },
      "veldDust":    { "hex": "#C8A86B", "rgb": [200, 168, 107], "role": "Lighter ochre — highlights / hover / warm fills" },
      "stingRed":    { "hex": "#C2401E", "rgb": [194, 64, 30],  "role": "Bee-sting / fearless charge / danger / the one hot CTA (sparingly)" }
    },
    "ramp": {
      "dryGrass":  { "hex": "#7E7A5A", "role": "Muted secondary text on dark / veld mid-tone" },
      "earth700":  { "hex": "#2A241D", "role": "Deep shadow / borders on dark" },
      "earth500":  { "hex": "#5A5043", "role": "Mid-shadow / muted dividers" },
      "boneDim":   { "hex": "#BDB6A6", "role": "Muted body text on dark (more legible than dryGrass)" },
      "cloud":     { "hex": "#F6F4EF", "role": "Warm off-white page background (light mode)" },
      "paper":     { "hex": "#FFFFFF", "role": "Print / max-contrast headlines" }
    },
    "semantic": {
      "bg":            "#161513",
      "bgRaised":      "#3A332B",
      "bgLight":       "#F6F4EF",
      "text":          "#EDE9E0",
      "textMuted":     "#BDB6A6",
      "textOnLight":   "#161513",
      "link":          "#B07A3C",
      "linkHover":     "#C8A86B",
      "border":        "#2A241D",
      "focusRing":     "#B07A3C",
      "accent":        "#B07A3C",
      "danger":        "#C2401E"
    }
  },
  "typography": {
    "families": {
      "display": "'Archivo Black', 'Saira Condensed', 'Bitter', system-ui, sans-serif",
      "heading": "'Space Grotesk', 'Inter', system-ui, sans-serif",
      "body":    "Inter, system-ui, -apple-system, sans-serif",
      "reading": "'Atkinson Hyperlegible', system-ui, -apple-system, sans-serif",
      "mono":    "'JetBrains Mono', ui-monospace, monospace"
    },
    "scale": {
      "xs":   "0.75rem",
      "sm":   "0.875rem",
      "base": "1rem",
      "lg":   "1.125rem",
      "xl":   "1.375rem",
      "2xl":  "1.75rem",
      "3xl":  "2.25rem",
      "4xl":  "3rem",
      "5xl":  "4rem"
    },
    "tracking": {
      "displayCaps": "0.04em",
      "eyebrowCaps": "0.12em",
      "body": "0em"
    },
    "rules": {
      "bodyMinPx": 16,
      "displayCapsAllUppercase": true,
      "maxDisplayLinesPerView": 1
    }
  },
  "taglines": {
    "primary": "Your story, told true.",
    "alts": [
      "The archer's eye. The badger's nerve.",
      "Aim true. Dig in.",
      "The gatekeepers kept 90%. We didn't care.",
      "We Uber'd the press. You keep most of the money.",
      "Craft, with claws.",
      "Action, without attachment.",
      "Be fearless like the African honey badger."
    ]
  }
}
