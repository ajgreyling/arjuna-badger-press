# ── OS / editor ────────────────────────────────────────────
.DS_Store

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── Node ───────────────────────────────────────────────────
node_modules/

# ── Heavy audio renders (these live with the audio pipeline, never here) ──
*.mp3
*.wav
*.m4a
*.m4b
*.flac
*.aac
*.ogg

# ── Regenerable build telemetry / dashboards ───────────────
**/build/log/
**/build/history/
**/build/viz/
*.log

# ── NEVER vendor copyrighted third-party reference material ─
**/ingest/

# ── Print-workshop PDFs (not the public download) ─────────────────────────────
**/build/export/*-jacket.pdf
**/build/export/*-print.pdf

# ── Generated static site output (rebuild with site/build.py) ─
site/public/

# ── Wikidata export (regenerate with tools/wikidata_export.py) ─
wikidata-export/

# ── ISBN tracker (regenerate with tools/isbn_tracker.py export) ─
isbn-tracker.csv
isbn-tracker.md

# ── Distribution upload sheet (regenerate: tools/distribution_sheet.py) ─
distribution-sheet.csv
distribution-sheet.md

# ── Translation A/B work trees (run tools/translate_ab.py) ─
**/build/.translate/
**/build/BOOK.*.anthropic.md
**/build/BOOK.*.openai.md
**/build/BOOK.*.aya.md

# book status audit intermediate (regenerate with tools/book_status_audit.py --json)
book-status-audit.json

# Buabantu per-chunk translation working dirs (intermediates; the assembled BOOK.<lang>-<tag>.md is the artifact)
books/**/build/.buabantu/

# Buabantu page-translation scratch (segment workdir; final poes.<lang>.md is the kept output)
site/content/.buabantu-page/

# ── Pre-polish chapter backups (git history already preserves the prior prose) ─
**/build/chapters/.pre-polish/

# ── Baked workflow scratch (regenerable; the whole book is inlined → huge) ─
.amber-*-baked.js
.amber-*-baked.*.js
.amber-*-args.json
.amber-*-args.*.json
.amber-nb-args.json

# ── Audiobook render working tree (regenerable; the .py + frontmatter .md are the source) ─
# Keep: audio/*.py and audio/*.md. Drop: the chunk cache, ffmpeg work dirs, manifest, exports.
books/**/audio/**/chunks/
books/**/audio/**/work/
books/**/audio/**/_work_m4b/
books/**/audio/**/_acx/
books/**/audio/**/_stale_prepolish/
books/**/audio/**/_archive/
books/**/audio/**/manifest.json
books/**/audio/**/*-concat.txt
books/**/audio/**/concat-list.txt
books/**/audio/**/scene.txt
